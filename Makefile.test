MEASUREMENT_REDUCE_TEST ?= bin/measurement_reduce_test
$(MEASUREMENT_REDUCE_TEST): tests/measurement_reduce_test.cu src/measurement_reduce.cuh src/measurement_launch.hpp src/work_buffer.hpp
	mkdir -p $(dir $@)
	$(NVCC) $(NVCC_CFLAGS) tests/measurement_reduce_test.cu -o $@ $(LDFLAGS_VENDOR) --cudart=shared

.PHONY: test-measurement-reduce
test-measurement-reduce: $(MEASUREMENT_REDUCE_TEST)
	./$(MEASUREMENT_REDUCE_TEST)

WORK_BUFFER_TEST ?= bin/work_buffer_test
$(WORK_BUFFER_TEST): tests/work_buffer_test.cpp src/work_buffer.hpp
	mkdir -p $(dir $@)
	$(CXX) -std=c++17 -Wall -Wextra -Werror $< -o $@

.PHONY: test-work-buffer
test-work-buffer: $(WORK_BUFFER_TEST)
	$(WORK_BUFFER_TEST)

# MPI_CXX must use the MPI installation linked into libqcs.
MPI_CXX ?= mpicxx
MEASUREMENT_INTEGRATION_TEST ?= bin/measurement_integration_test
$(MEASUREMENT_INTEGRATION_TEST): tests/measurement_integration_test.cpp include/qcs.h $(LIBQCS_SO)
	mkdir -p $(dir $@)
	$(MPI_CXX) -std=c++17 $(INCLUDE) $< -L$(dir $(LIBQCS_SO)) -lqcs $(QCS_LDFLAGS) -o $@

.PHONY: test-measurement-integration
test-measurement-integration: $(MEASUREMENT_INTEGRATION_TEST)
	./$(MEASUREMENT_INTEGRATION_TEST)

INITIAL_STATE_TEST ?= bin/initial_state_test
$(INITIAL_STATE_TEST): tests/initial_state_test.cu src/qcs.cu src/measurement_reduce.cuh src/measurement_launch.hpp src/work_buffer.cuh src/work_buffer.hpp src/nccl_buffer.cuh src/swap_launch.hpp include/qcs.h src/pauli_reduce.cuh src/pauli_string.hpp
	mkdir -p $(dir $@)
	$(NVCC) $(NVCC_CFLAGS) $< -o $@ $(NVCC_LDFLAGS)

.PHONY: test-initial-state
test-initial-state: $(INITIAL_STATE_TEST)
	./$(INITIAL_STATE_TEST)

# Compile private instrumented source copies, including the recorded CUB tree.
# Vendor flags must include the same MPI headers/libraries as the production build.
MEASUREMENT_METADATA ?= constant
MEASUREMENT_HARNESS_SOURCE ?= $(CURDIR)
MEASUREMENT_HARNESS_DIR ?= bin/measurement-harness-$(MEASUREMENT_METADATA)
MEASUREMENT_HARNESS = $(MEASUREMENT_HARNESS_DIR)/measurement_harness
MEASUREMENT_HARNESS_ARGS ?= regression 12

$(MEASUREMENT_HARNESS_DIR)/qcs.cu: scripts/prepare_measurement_harness.py $(MEASUREMENT_HARNESS_SOURCE)/src/qcs.cu $(wildcard $(MEASUREMENT_HARNESS_SOURCE)/src/measurement_reduce.cuh $(MEASUREMENT_HARNESS_SOURCE)/src/measurement_launch.hpp $(MEASUREMENT_HARNESS_SOURCE)/src/pauli_reduce.cuh $(MEASUREMENT_HARNESS_SOURCE)/src/pauli_string.hpp $(MEASUREMENT_HARNESS_SOURCE)/src/work_buffer.* $(MEASUREMENT_HARNESS_SOURCE)/src/nccl_buffer.cuh $(MEASUREMENT_HARNESS_SOURCE)/src/swap_launch.hpp)
	python3 scripts/prepare_measurement_harness.py --source $(MEASUREMENT_HARNESS_SOURCE) --output $(MEASUREMENT_HARNESS_DIR) --metadata $(MEASUREMENT_METADATA)

$(MEASUREMENT_HARNESS): tests/measurement_harness.cu tests/measurement_sampling_cases.hpp tests/measurement_probe.hpp $(MEASUREMENT_HARNESS_DIR)/qcs.cu
	$(NVCC) $(NVCC_CFLAGS) -I$(abspath $(MEASUREMENT_HARNESS_DIR)) tests/measurement_harness.cu -o $@ $(NVCC_LDFLAGS)

.PHONY: measurement-harness test-measurement-distributed benchmark-measurement
measurement-harness: $(MEASUREMENT_HARNESS)
test-measurement-distributed: $(MEASUREMENT_HARNESS)
	$(MPIEXEC) -n $(RANKS) ./$(MEASUREMENT_HARNESS) $(MEASUREMENT_HARNESS_ARGS)
benchmark-measurement: $(MEASUREMENT_HARNESS)
	$(MPIEXEC) -n $(RANKS) ./$(MEASUREMENT_HARNESS) benchmark $(BENCH_QUBITS) $(BENCH_WARMUPS) $(BENCH_REPETITIONS)

MPIEXEC ?= mpiexec
RANKS ?= 1
BENCH_QUBITS ?= 12
BENCH_WARMUPS ?= 5
BENCH_REPETITIONS ?= 30

$(MEASUREMENT_HARNESS_DIR)/measurement_integration_test: tests/measurement_integration_private.cu tests/measurement_integration_test.cpp tests/measurement_probe.hpp $(MEASUREMENT_HARNESS_DIR)/qcs.cu
	$(NVCC) $(NVCC_CFLAGS) -I$(abspath $(MEASUREMENT_HARNESS_DIR)) tests/measurement_integration_private.cu -o $@ $(NVCC_LDFLAGS)

.PHONY: test-measurement-metadata
test-measurement-metadata: $(MEASUREMENT_HARNESS_DIR)/measurement_integration_test $(MEASUREMENT_HARNESS)
	$(MPIEXEC) -n $(RANKS) ./$(MEASUREMENT_HARNESS_DIR)/measurement_integration_test
	$(MPIEXEC) -n $(RANKS) ./$(MEASUREMENT_HARNESS) regression 12

# Build only; run explicitly under the target cluster's MPI launcher.
NCCL_BUFFER_HARNESS ?= bin/nccl-buffer-$(NCCL_BUFFER_MODE)
$(NCCL_BUFFER_HARNESS): tests/nccl_buffer_harness.cu src/qcs.cu src/measurement_reduce.cuh src/measurement_launch.hpp src/work_buffer.cuh src/work_buffer.hpp src/nccl_buffer.cuh src/swap_launch.hpp include/qcs.h src/pauli_reduce.cuh src/pauli_string.hpp
	mkdir -p $(dir $@)
	$(NVCC) $(NVCC_CFLAGS) $< -o $@ $(NVCC_LDFLAGS)

.PHONY: nccl-buffer-harness
nccl-buffer-harness: $(NCCL_BUFFER_HARNESS)

# Include every test and harness binary in the main clean target.
TEST_BINARIES = $(MEASUREMENT_REDUCE_TEST) $(MEASUREMENT_INTEGRATION_TEST) $(WORK_BUFFER_TEST) $(INITIAL_STATE_TEST) \
	$(MEASUREMENT_HARNESS) $(MEASUREMENT_HARNESS_DIR)/measurement_integration_test $(NCCL_BUFFER_HARNESS)

# Standalone translation unit using private amplitude access; production is unchanged.
SWAP_HARNESS ?= bin/swap_harness
$(SWAP_HARNESS): tests/swap_harness.cu src/qcs.cu src/measurement_reduce.cuh src/measurement_launch.hpp src/work_buffer.cuh src/work_buffer.hpp src/nccl_buffer.cuh src/swap_launch.hpp include/qcs.h src/pauli_reduce.cuh src/pauli_string.hpp
	mkdir -p $(dir $@)
	$(NVCC) $(NVCC_CFLAGS) $< -o $@ $(NVCC_LDFLAGS)

.PHONY: swap-harness test-swap benchmark-swap
swap-harness: $(SWAP_HARNESS)
test-swap: $(SWAP_HARNESS)
	$(MPIEXEC) -n $(RANKS) $(abspath $(SWAP_HARNESS)) regression 12
benchmark-swap: $(SWAP_HARNESS)
	$(MPIEXEC) -n $(RANKS) $(abspath $(SWAP_HARNESS)) benchmark $(BENCH_QUBITS) $(BENCH_WARMUPS) $(BENCH_REPETITIONS)

TEST_BINARIES += $(SWAP_HARNESS)

SWAP_LAUNCH_TEST ?= bin/swap_launch_test
$(SWAP_LAUNCH_TEST): tests/swap_launch_test.cpp src/swap_launch.hpp
	mkdir -p $(dir $@)
	$(CXX) -std=c++17 -Wall -Wextra -Werror $< -o $@

.PHONY: test-swap-launch
test-swap-launch: $(SWAP_LAUNCH_TEST)
	$(SWAP_LAUNCH_TEST)

TEST_BINARIES += $(SWAP_LAUNCH_TEST)

SWAP_LARGE_QUBITS ?= 20
.PHONY: test-swap-large
test-swap-large: $(SWAP_HARNESS)
	$(MPIEXEC) -n $(RANKS) $(abspath $(SWAP_HARNESS)) large $(SWAP_LARGE_QUBITS)

PAULI_STRING_TEST ?= bin/pauli_string_test
$(PAULI_STRING_TEST): tests/pauli_string_test.cpp tests/pauli_reference.hpp src/pauli_string.hpp include/qcs.h
	mkdir -p $(dir $@)
	$(CXX) -std=c++17 -Wall -Wextra -Werror $< -o $@

.PHONY: test-pauli-string
test-pauli-string: $(PAULI_STRING_TEST)
	$(PAULI_STRING_TEST)

TEST_BINARIES += $(PAULI_STRING_TEST)

PAULI_REDUCE_TEST ?= bin/pauli_reduce_test
$(PAULI_REDUCE_TEST): tests/pauli_reduce_test.cu tests/pauli_reference.hpp src/pauli_reduce.cuh src/pauli_string.hpp include/qcs.h src/measurement_reduce.cuh src/measurement_launch.hpp src/work_buffer.hpp
	mkdir -p $(dir $@)
	$(NVCC) $(NVCC_CFLAGS) $< -o $@ $(LDFLAGS_VENDOR) --cudart=shared

.PHONY: test-pauli-reduce
test-pauli-reduce: $(PAULI_REDUCE_TEST)
	$(PAULI_REDUCE_TEST)

TEST_BINARIES += $(PAULI_REDUCE_TEST)

PAULI_CORE_TEST ?= bin/pauli_core_test
$(PAULI_CORE_TEST): tests/pauli_core_test.cu tests/pauli_reference.hpp src/qcs.cu src/pauli_reduce.cuh src/pauli_string.hpp src/measurement_reduce.cuh src/measurement_launch.hpp src/work_buffer.cuh src/work_buffer.hpp src/nccl_buffer.cuh src/swap_launch.hpp include/qcs.h
	mkdir -p $(dir $@)
	$(NVCC) $(NVCC_CFLAGS) $< -o $@ $(NVCC_LDFLAGS)

.PHONY: test-pauli-core
test-pauli-core: $(PAULI_CORE_TEST)
	$(MPIEXEC) -n $(RANKS) $(abspath $(PAULI_CORE_TEST))

TEST_BINARIES += $(PAULI_CORE_TEST)

PAULI_API_TEST ?= bin/pauli_api_test
PAULI_API_C_OBJECT ?= bin/pauli_api_c.o
$(PAULI_API_C_OBJECT): tests/pauli_api_c.c include/qcs.h
	mkdir -p $(dir $@)
	$(CC) -std=c11 -Wall -Wextra -Werror $(INCLUDE) -c $< -o $@

$(PAULI_API_TEST): tests/pauli_api_test.cpp $(PAULI_API_C_OBJECT) include/qcs.h $(LIBQCS_SO)
	mkdir -p $(dir $@)
	$(CXX) -std=c++17 -Wall -Wextra -Werror $(INCLUDE) $< $(PAULI_API_C_OBJECT) -L$(dir $(LIBQCS_SO)) -lqcs $(QCS_LDFLAGS) -o $@

.PHONY: test-pauli-api
test-pauli-api: $(PAULI_API_TEST)
	$(MPIEXEC) -n $(RANKS) $(abspath $(PAULI_API_TEST))

TEST_BINARIES += $(PAULI_API_TEST) $(PAULI_API_C_OBJECT)

# Reuse the measurement copier for constant/global metadata source variants.
PAULI_CORE_METADATA_TEST ?= $(MEASUREMENT_HARNESS_DIR)/pauli_core_test
$(PAULI_CORE_METADATA_TEST): tests/pauli_core_test.cu tests/pauli_reference.hpp $(MEASUREMENT_HARNESS_DIR)/qcs.cu
	mkdir -p $(dir $@)
	$(NVCC) $(NVCC_CFLAGS) -DQCS_PAULI_SOURCE='"$(abspath $(MEASUREMENT_HARNESS_DIR))/qcs.cu"' $< -o $@ $(NVCC_LDFLAGS)

.PHONY: test-pauli-distributed
test-pauli-distributed: $(PAULI_CORE_METADATA_TEST)
	$(MPIEXEC) -n $(RANKS) $(abspath $(PAULI_CORE_METADATA_TEST))

TEST_BINARIES += $(PAULI_CORE_METADATA_TEST)

PAULI_BENCHMARK ?= bin/pauli_benchmark
$(PAULI_BENCHMARK): tests/pauli_benchmark.cu src/qcs.cu src/pauli_reduce.cuh src/pauli_string.hpp src/measurement_reduce.cuh src/measurement_launch.hpp src/work_buffer.cuh src/work_buffer.hpp src/nccl_buffer.cuh src/swap_launch.hpp include/qcs.h
	mkdir -p $(dir $@)
	$(NVCC) $(NVCC_CFLAGS) $< -o $@ $(NVCC_LDFLAGS)

.PHONY: benchmark-pauli
benchmark-pauli: $(PAULI_BENCHMARK)
	$(MPIEXEC) -n $(RANKS) $(abspath $(PAULI_BENCHMARK)) $(BENCH_QUBITS) $(BENCH_WARMUPS) $(BENCH_REPETITIONS)

TEST_BINARIES += $(PAULI_BENCHMARK)

MEASUREMENT_LAUNCH_TEST ?= bin/measurement_launch_test
$(MEASUREMENT_LAUNCH_TEST): tests/measurement_launch_test.cpp src/measurement_launch.hpp
	mkdir -p $(dir $@)
	$(CXX) -std=c++17 -Wall -Wextra -Werror $< -o $@

.PHONY: test-measurement-launch
test-measurement-launch: $(MEASUREMENT_LAUNCH_TEST)
	$(MEASUREMENT_LAUNCH_TEST)

TEST_BINARIES += $(MEASUREMENT_LAUNCH_TEST)

MEASUREMENT_BACKEND_BENCHMARK ?= bin/measurement_backend_benchmark
MEASUREMENT_BACKEND_PROFILE ?= bin/measurement_backend_profile
MEASUREMENT_BACKEND_DEPS = tests/measurement_backend_benchmark.cu $(wildcard src/*.cuh src/*.hpp) src/qcs.cu include/qcs.h
$(MEASUREMENT_BACKEND_BENCHMARK): $(MEASUREMENT_BACKEND_DEPS)
	mkdir -p $(dir $@)
	$(NVCC) $(NVCC_CFLAGS) $< -o $@ $(NVCC_LDFLAGS)
$(MEASUREMENT_BACKEND_PROFILE): $(MEASUREMENT_BACKEND_DEPS)
	mkdir -p $(dir $@)
	$(NVCC) $(NVCC_CFLAGS) -DQCS_MEASUREMENT_PROFILE $< -o $@ $(NVCC_LDFLAGS)

.PHONY: measurement-backend-benchmark measurement-backend-profile
measurement-backend-benchmark: $(MEASUREMENT_BACKEND_BENCHMARK)
measurement-backend-profile: $(MEASUREMENT_BACKEND_PROFILE)

# Private source-copy builds also consume the compile-time profiling header.
$(LIBQCS_SO) $(PAULI_BENCHMARK) $(PAULI_CORE_TEST) $(INITIAL_STATE_TEST): src/measurement_profile.hpp
$(MEASUREMENT_HARNESS_DIR)/qcs.cu: src/measurement_profile.hpp

MEASUREMENT_BACKEND_TEST ?= bin/measurement_backend_test
$(MEASUREMENT_BACKEND_TEST): tests/measurement_backend_test.cpp src/measurement_backend.hpp
	mkdir -p $(dir $@)
	$(CXX) -std=c++17 -Wall -Wextra -Werror $< -o $@

.PHONY: test-measurement-backend
test-measurement-backend: $(MEASUREMENT_BACKEND_TEST)
	$(MEASUREMENT_BACKEND_TEST)

TEST_BINARIES += $(MEASUREMENT_BACKEND_TEST)
$(LIBQCS_SO) $(PAULI_BENCHMARK) $(PAULI_CORE_TEST) $(INITIAL_STATE_TEST): src/measurement_backend.hpp
$(MEASUREMENT_HARNESS_DIR)/qcs.cu: src/measurement_backend.hpp

TILED_CDF_TEST ?= bin/measurement_tiled_cdf_test
$(TILED_CDF_TEST): tests/measurement_tiled_cdf_test.cu src/measurement_tiled_cdf.cuh src/measurement_profile.hpp
	mkdir -p $(dir $@)
	$(NVCC) $(NVCC_CFLAGS) $< -o $@ $(LDFLAGS_VENDOR) --cudart=shared

.PHONY: test-measurement-tiled-cdf
test-measurement-tiled-cdf: $(TILED_CDF_TEST)
	./$(TILED_CDF_TEST)

TEST_BINARIES += $(TILED_CDF_TEST)

# Every direct and copied-source consumer must rebuild when tiled primitives change.
$(LIBQCS_SO) $(PAULI_BENCHMARK) $(PAULI_CORE_TEST) $(INITIAL_STATE_TEST) $(NCCL_BUFFER_HARNESS) $(SWAP_HARNESS): src/measurement_tiled_cdf.cuh
$(MEASUREMENT_HARNESS_DIR)/qcs.cu: src/measurement_tiled_cdf.cuh

.PHONY: test-measurement-tiled-integration
test-measurement-tiled-integration: $(MEASUREMENT_HARNESS_DIR)/measurement_integration_test
	QCS_MEASUREMENT_BACKEND=tiled_cdf $(MPIEXEC) -n $(RANKS) ./$(MEASUREMENT_HARNESS_DIR)/measurement_integration_test

TEST_BINARIES += $(MEASUREMENT_BACKEND_BENCHMARK) $(MEASUREMENT_BACKEND_PROFILE)
BENCH_BACKENDS ?= grouped rank_sampled tiled_cdf auto
BENCH_OUTPUT ?= results/measurement
.PHONY: benchmark-measurement-backends
benchmark-measurement-backends: $(MEASUREMENT_BACKEND_BENCHMARK)
	python3 scripts/benchmark_measurement.py --no-build --binary $(MEASUREMENT_BACKEND_BENCHMARK) --output $(BENCH_OUTPUT) --ranks $(RANKS) --qubits $(BENCH_QUBITS) --warmups $(BENCH_WARMUPS) --repetitions $(BENCH_REPETITIONS) --backends $(BENCH_BACKENDS) --mpiexec '$(MPIEXEC)'

MEASUREMENT_RACE_TEST ?= bin/measurement_race_test
$(MEASUREMENT_RACE_TEST): tests/measurement_race_test.cpp src/measurement_race.hpp
	mkdir -p $(dir $@)
	$(CXX) -std=c++17 -Wall -Wextra -Werror $< -o $@
.PHONY: test-measurement-race test-measurement-race-integration
test-measurement-race: $(MEASUREMENT_RACE_TEST)
	./$(MEASUREMENT_RACE_TEST)
test-measurement-race-integration: $(MEASUREMENT_HARNESS_DIR)/measurement_integration_test
	QCS_MEASUREMENT_BACKEND=tiled_race $(MPIEXEC) -n $(RANKS) ./$(MEASUREMENT_HARNESS_DIR)/measurement_integration_test
TEST_BINARIES += $(MEASUREMENT_RACE_TEST)
$(LIBQCS_SO) $(PAULI_BENCHMARK) $(PAULI_CORE_TEST) $(INITIAL_STATE_TEST) $(NCCL_BUFFER_HARNESS) $(SWAP_HARNESS): src/measurement_race.hpp
$(MEASUREMENT_HARNESS_DIR)/qcs.cu: src/measurement_race.hpp

MEASUREMENT_RACE_DEVICE_TEST ?= bin/measurement_race_device_test
$(MEASUREMENT_RACE_DEVICE_TEST): tests/measurement_race_device_test.cu src/measurement_race_nccl.cuh src/measurement_race.hpp src/measurement_tiled_cdf.cuh
	mkdir -p $(dir $@)
	$(NVCC) $(NVCC_CFLAGS) $< -o $@ $(LDFLAGS_VENDOR) --cudart=shared
.PHONY: test-measurement-race-device test-measurement-race-nccl-integration
test-measurement-race-device: $(MEASUREMENT_RACE_DEVICE_TEST)
	./$(MEASUREMENT_RACE_DEVICE_TEST)
test-measurement-race-nccl-integration: $(MEASUREMENT_HARNESS_DIR)/measurement_integration_test
	QCS_MEASUREMENT_BACKEND=tiled_race_nccl $(MPIEXEC) -n $(RANKS) ./$(MEASUREMENT_HARNESS_DIR)/measurement_integration_test
TEST_BINARIES += $(MEASUREMENT_RACE_DEVICE_TEST)
$(LIBQCS_SO) $(PAULI_BENCHMARK) $(PAULI_CORE_TEST) $(INITIAL_STATE_TEST) $(NCCL_BUFFER_HARNESS) $(SWAP_HARNESS): src/measurement_race_nccl.cuh
$(MEASUREMENT_HARNESS_DIR)/qcs.cu: src/measurement_race_nccl.cuh
